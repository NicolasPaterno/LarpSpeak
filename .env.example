# Copy to .env to override defaults used by docker-compose.yml.
# MiniStack accepts any credentials; these are not real AWS keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# media-relay: simulated unstable dependency (R5)
RELAY_LATENCY_MS=200
RELAY_FAILURE_RATE=0.0
# media-relay: a participant whose client sends no packets this long is removed (crash, lost network)
PARTICIPANT_TIMEOUT_MS=15000
# call-signaling: how long the saga waits for a relay before compensating (F7)
RELAY_TIMEOUT_MS=3000
# call-signaling: upper limit for a call's maxParticipants (R2 / F5)
MAX_PARTICIPANTS=10
# media-relay replicas (R4 / F8)
MEDIA_RELAY_REPLICAS=2
# audit-vault: Bearer token required by GET /audit/* (change it outside demos)
AUDIT_API_TOKEN=larpspeak-audit-demo
# media-relay: length of each recorded audio chunk (call recording, browser audio)
AUDIO_CHUNK_MS=5000
