{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larpspeak.local/contracts/events/CallFailed.v1.schema.json",
  "title": "CallFailed v1",
  "description": "Fact: the call saga was compensated (seat released, caller notified). Channel: SNS call-events -> media-relay, audit-vault.",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "CallFailed" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["callId", "reason"],
      "properties": { "callId": { "type": "string" }, "reason": { "type": "string" } }
    }
  }
}
