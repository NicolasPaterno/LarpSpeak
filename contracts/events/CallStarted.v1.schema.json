{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larpspeak.local/contracts/events/CallStarted.v1.schema.json",
  "title": "CallStarted v1",
  "description": "Fact: a call is live. Channel: SNS call-events -> media-relay, audit-vault.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "CallStarted"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "callId",
        "kind",
        "capacity",
        "relayId",
        "participants"
      ],
      "properties": {
        "callId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "direct",
            "group"
          ]
        },
        "relayId": {
          "type": "string"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 2
        }
      }
    }
  }
}
