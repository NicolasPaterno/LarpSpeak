{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larpspeak.local/contracts/events/RelayClosed.v1.schema.json",
  "title": "RelayClosed v1",
  "description": "Fact: media-relay freed a relay on its own (no audio for RELAY_IDLE_TIMEOUT_MS); call-signaling ends the call. Channel: SQS relay-results (media-relay -> call-signaling).",
  "allOf": [{ "$ref": "../envelope.schema.json" }],
  "properties": {
    "type": { "const": "RelayClosed" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["callId", "relayId", "reason"],
      "properties": { "callId": { "type": "string" }, "relayId": { "type": "string" }, "reason": { "type": "string" } }
    }
  }
}
