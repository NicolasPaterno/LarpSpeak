{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://larpspeak.local/contracts/events/ParticipantLeft.v1.schema.json",
  "title": "ParticipantLeft v1",
  "description": "Fact: a user left an active call and freed a seat. media-relay stops forwarding the user's audio; audit-vault records it. Channel: SNS call-events -> media-relay, audit-vault.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ParticipantLeft"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "callId",
        "userId"
      ],
      "properties": {
        "callId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        }
      }
    }
  }
}
